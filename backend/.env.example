# LenseScan Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (PostgreSQL) ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://lensescan_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/lensescan_db

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=10

# --- OCR ---
# Comma-separated language codes for EasyOCR
OCR_LANGUAGES=en,hi
# Default DPI for pixel-to-mm conversion when EXIF data unavailable
DEFAULT_DPI=300
